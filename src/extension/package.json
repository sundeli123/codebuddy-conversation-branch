{
  "name": "codebuddy-branch",
  "displayName": "CodeBuddy 对话分支",
  "description": "从当前对话的任意一轮分叉出一个新对话（自动导入，不重载、不打断正在跑的任务）",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codebuddyBranch.branch"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codebuddyBranch.branch",
        "title": "分支: 从当前对话的某一轮分叉"
      },
      {
        "command": "codebuddyBranch.probe",
        "title": "分支: 诊断（写日志）"
      }
    ],
    "keybindings": [
      {
        "command": "codebuddyBranch.branch",
        "key": "ctrl+alt+b"
      },
      {
        "command": "codebuddyBranch.branch",
        "key": "ctrl+alt+j"
      }
    ]
  }
}
